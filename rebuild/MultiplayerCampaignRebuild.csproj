<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <AssemblyName>MultiplayerCampaign</AssemblyName>
    <RootNamespace>MultiplayerCampaign</RootNamespace>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <AutoGenerateBindingRedirects>false</AutoGenerateBindingRedirects>
    <OutputPath>bin\Debug\netstandard2.0\</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <NoWarn>MSB3277</NoWarn>
    <MpcLoopRevision>Reconnect-PartyAB-CharacterSlots</MpcLoopRevision>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Bannerlord.ReferenceAssemblies" Version="1.3.4.102350" PrivateAssets="all" />
    <PackageReference Include="Lib.Harmony.Ref" Version="2.3.4" PrivateAssets="all" />
  </ItemGroup>

</Project>
